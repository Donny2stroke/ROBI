# Copia in .env e personalizza prima di avviare (file ignorato da git)
ROBI_CAMERA_BACKEND=MSMF
ROBI_CAMERA_INDEX=0
ROBI_CAMERA_WIDTH=640
ROBI_CAMERA_HEIGHT=480
ROBI_CAMERA_FPS=30
ROBI_CAMERA_FOURCC=YUY2
ROBI_JPEG_QUALITY=60

# Classificatore opzionale: richiede pip install -e ".[dev,emotion]"
ROBI_AI_EXPRESSION_ENABLED=0
ROBI_AI_EXPRESSION_HZ=3
